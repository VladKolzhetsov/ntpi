# === Настройки LLM (OpenAI-совместимый API) ===
# Скопируй этот файл в .env и заполни своими значениями.

# Базовый URL API, например:
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
API_BASE=https://api.neuraldeep.ru/v1

# API-ключ (для локальных серверов вроде Ollama можно любой, например "ollama")
API_KEY=sk-obOvR2O5WMk8Odf_Eom18g

# Провайдер модели: openai, anthropic и т.п.
# Для OpenAI-совместимых endpoints обычно "openai"
MODEL_PROVIDER=openai

# Имя модели, например "gpt-4o-mini", "qwen/qwen3", "llama3.1" ...
#MODEL_NAME=...

# Проверять ли SSL-сертификат (false — полезно для локальных серверов)
LLM_SSL_VERIFY=false
